rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() {
      return request.auth != null;
    }

    // Admin = has a document in /admins/{uid}.
    // IMPORTANT: seed the FIRST admin manually in the Firebase console
    // (create a doc at admins/<your-uid> with any content, e.g. { role: "owner" }).
    // After that, existing admins can add more admins from the app.
    function isAdmin() {
      return isSignedIn()
        && exists(/databases/$(database)/documents/admins/$(request.auth.uid));
    }

    // Keys changed by this write — used for field-level control.
    function changedKeys() {
      return request.resource.data.diff(resource.data).affectedKeys();
    }

    // ---- Admin registry -------------------------------------------------
    // Signed-in users may READ (the client checks its own membership here);
    // only existing admins may WRITE. Bootstrap the first admin in console.
    match /admins/{uid} {
      allow read: if isSignedIn();
      allow write: if isAdmin();
    }

    // ---- User profiles --------------------------------------------------
    // A user manages only their own profile. Reads limited to self + admin
    // (previously any signed-in user could enumerate every staff member).
    match /users/{userId} {
      allow read: if isSignedIn() && (request.auth.uid == userId || isAdmin());
      allow create, update: if isSignedIn() && request.auth.uid == userId;
      allow delete: if isAdmin();
    }

    // ---- Billing --------------------------------------------------------
    // Create only records stamped with your own uid; owner or admin may
    // read/update (soft-delete is an update); only admin may hard-delete.
    match /billing/{invoiceId} {
      allow create: if isSignedIn() && request.resource.data.createdBy == request.auth.uid;
      allow read, update: if isSignedIn() && (isAdmin() || resource.data.createdBy == request.auth.uid);
      allow delete: if isAdmin();
    }

    // ---- Inventory ------------------------------------------------------
    // Balanced model: staff may add products and edit them (receiving stock,
    // fixing details), but only admin may DELETE or change the SELLING PRICE
    // of an existing product.
    match /inventory/{id} {
      allow read: if isSignedIn();
      allow create: if isSignedIn();
      allow delete: if isAdmin();
      allow update: if isAdmin() || (isSignedIn() && !changedKeys().hasAny(['price']));
    }

    // ---- Procurement ----------------------------------------------------
    // Suppliers: staff may add/edit (they receive stock); only admin deletes.
    match /suppliers/{id} {
      allow read: if isSignedIn();
      allow create, update: if isSignedIn();
      allow delete: if isAdmin();
    }
    // Purchases: create stamped with your own uid; ANY staff may update
    // (settling a colleague's supplier purchase is normal counter work);
    // only admin deletes.
    match /purchases/{id} {
      allow read: if isSignedIn();
      allow create: if isSignedIn() && request.resource.data.createdBy == request.auth.uid;
      allow update: if isSignedIn();
      allow delete: if isAdmin();
    }
    // Stock movements: append-only audit trail. No edits or deletes from the
    // app (the admin catch-all below still lets an admin correct mistakes).
    match /stock_movements/{id} {
      allow read: if isSignedIn();
      allow create: if isSignedIn() && request.resource.data.createdBy == request.auth.uid;
      allow update, delete: if false;
    }

    // ---- Catalogs -------------------------------------------------------
    // Staff may add and edit services / old-item names (daily counter work);
    // only admin may delete.
    match /service/{id} {
      allow read: if isSignedIn();
      allow create, update: if isSignedIn();
      allow delete: if isAdmin();
    }
    match /old_items_master/{id} {
      allow read: if isSignedIn();
      allow create, update: if isSignedIn();
      allow delete: if isAdmin();
    }

    // ---- Expenses -------------------------------------------------------
    // Create only your own; owner or admin may read/update/delete.
    match /expenses/{expenseId} {
      allow create: if isSignedIn() && request.resource.data.createdBy == request.auth.uid;
      allow read, update, delete: if isSignedIn() && (isAdmin() || resource.data.createdBy == request.auth.uid);
    }

    // ---- Shop settings --------------------------------------------------
    // Everyone reads. Admin may write anything. Regular staff may bump the
    // invoice counter at checkout and change the app language / font size —
    // but NOT the shop's UPI IDs, name, or address (payment-diversion hole).
    match /settings/shopProfile {
      allow read: if isSignedIn();
      allow write: if isAdmin() || (isSignedIn()
        && changedKeys().hasOnly(['nextInvoiceNumber', 'appLanguage', 'appFontSize']));
    }

    // ---- Everything else ------------------------------------------------
    match /{document=**} {
      allow read, write: if isAdmin();
    }
  }
}
